{
  "expo": {
    "name": "智能冰箱助手",
    "slug": "fridge-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f5f5f3"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fridgeassistant.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f5f5f3"
      },
      "package": "com.fridgeassistant.app"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-image-picker"
    ],
    "scheme": "fridge"
  }
}
