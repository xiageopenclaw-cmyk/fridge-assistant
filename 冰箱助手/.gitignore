# ── Fridge Assistant monorepo .gitignore ──
# 仓库根：/冰箱助手/
# 子项目：fridge-app/ (Expo Web) + fridge-backend/ (FastAPI)

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
*.db
*.db-shm
*.db-wal
.env
.env.local

# ── Node / Expo ──
node_modules/
.expo/
dist/
web-build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# ── Media (设计稿历史文件不入仓；最终素材用 webp 入仓) ──
UI设计/
fridge-app/dist/
fridge-app/assets/*.png
fridge-app/assets/*.jpg
fridge-app/assets/*.jpeg
fridge-app/assets/*.webp
!fridge-app/assets/*.webp
fridge-app/assets/3d-clay/

# ── 临时 / 备份 ──
*.bak
*.swp
.DS_Store
Thumbs.db
*~

# ── OpenClaw / workspace artifacts (误把整个 workspace 拖进来时防护) ──
.clawhub/
.openclaw/
memory/
skills/
avatars/
*.jpg
!fridge-app/assets/*.webp

# ── 项目级 .gitignore 仍然生效 ──
fridge-app/.gitignore
fridge-backend/.gitignore
